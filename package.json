{
  "name": "inferencer",
  "version": "0.0.14",
  "description": "DOM Element Enhancement that makes commonly used inferences",
  "homepage": "https://github.com/bahrus/inferencer#readme",
  "bugs": {
    "url": "https://github.com/bahrus/inferencer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/inferencer.git"
  },
  "license": "MIT",
  "author": "Bruce B. Anderson <anderson.bruce.b@gmail.com>",
  "type": "module",
  "types": "types/inferencer/types.d.ts",
  "files": [
    "*.js",
    "*.ts",
    "README.md",
    "LICENSE",
    "types/inferencer/types.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./inferencer.ts",
      "default": "./inferencer.js"
    },
    "./inferencer.js": {
      "types": "./inferencer.ts",
      "default": "./inferencer.js"
    },
    "./InferencedPropagator.js": {
      "types": "./InferencedPropagator.ts",
      "default": "./InferencedPropagator.js"
    },
    "./upSearch.js": {
      "types": "./upSearch.ts",
      "default": "./upSearch.js"
    }
  },
  "main": "inferencer.js",
  "module": "inferencer.js",
  "scripts": {
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "update": "ncu -u && npm install",
    "safari": "npx playwright wk http://localhost:8000",
    "chrome": "npx playwright cr http://localhost:8000"
  },
  "dependencies": {
    "assign-gingerly": "0.0.93"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "spa-ssi": "0.0.28",
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  }
}
